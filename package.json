{
  "name": "nu-portal",
  "version": "0.1.0",
  "description": "Auto-apply assistant for Northeastern NUworks co-op and job postings, with a human approval step before every submit.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "nup": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "login": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts login",
    "session:check": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts session:check",
    "doctor": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts doctor",
    "backup": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts backup",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "profile:check": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts profile:check",
    "letter:sample": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts letter:sample"
  },
  "dependencies": {
    "playwright": "^1.48.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
